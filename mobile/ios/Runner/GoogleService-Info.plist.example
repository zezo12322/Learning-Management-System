<?xml version="1.0" encoding="UTF-8"?>
<!-- ⚠️ هذا مثال فقط! استبدله بالملف الحقيقي من Firebase Console -->
<!-- Instructions:
  1. اذهب إلى https://console.firebase.google.com/
  2. اختر مشروعك → اضغط على أيقونة iOS
  3. اتبع خطوات الإعداد
  4. نزّل GoogleService-Info.plist وضعه في mobile/ios/Runner/
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>API_KEY</key><string>YOUR_IOS_API_KEY</string>
  <key>GCM_SENDER_ID</key><string>YOUR_MESSAGING_SENDER_ID</string>
  <key>PLIST_VERSION</key><string>1</string>
  <key>BUNDLE_ID</key><string>com.optimatech.lms</string>
  <key>PROJECT_ID</key><string>YOUR_PROJECT_ID</string>
  <key>STORAGE_BUCKET</key><string>YOUR_PROJECT_ID.appspot.com</string>
  <key>IS_ADS_ENABLED</key><false/>
  <key>IS_ANALYTICS_ENABLED</key><false/>
  <key>IS_APPINVITE_ENABLED</key><true/>
  <key>IS_GCM_ENABLED</key><true/>
  <key>IS_SIGNIN_ENABLED</key><true/>
  <key>GOOGLE_APP_ID</key><string>YOUR_IOS_APP_ID</string>
</dict>
</plist>
