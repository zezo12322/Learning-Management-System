{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "test": "jest",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@dataconnect/admin-generated": "file:dataconnect-admin-generated",
    "@dataconnect/functions-generated": "file:dataconnect-generated",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2-rc.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "firebase-admin": "$firebase-admin",
    "firebase-functions-test": {
      "firebase-functions": "$firebase-functions"
    },
    "ts-jest": {
      "typescript": "$typescript"
    },
    "typescript-eslint": {
      "typescript": "$typescript"
    },
    "uuid": "^11.1.1",
    "ts-deepmerge": "^8.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.5.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "private": true,
  "allowScripts": {
    "firebase-admin@13.10.0": true,
    "@firebase/util": true,
    "protobufjs": true,
    "unrs-resolver": true
  }
}
