    "@tanstack/react-query": "^5.20.2",
    "@tanstack/react-query-devtools": "^5.20.2",
    "axios": "^1.6.7",
    "clsx": "^2.1.0",
    "firebase": "^10.14.1",
    "hls.js": "^1.6.17",
    "lucide-react": "^0.323.0",
    "next": "^15.5.22",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.1",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260717.1",
