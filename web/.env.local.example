# OptimaTech LMS — Web env (copy to .env.local and fill in)

# NestJS backend base URL (global prefix /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Firebase web app config (Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# AI features are intentionally unavailable in this release (Coming Soon).
NEXT_PUBLIC_AI_API_URL=

# Never add payment secret keys or HMAC values to NEXT_PUBLIC_* variables.
# Payment session creation must run in a trusted server or serverless function.

# Optional preselected category UUID for course creation.
NEXT_PUBLIC_DEFAULT_CATEGORY_ID=
