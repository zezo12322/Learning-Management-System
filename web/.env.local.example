# OptimaTech LMS — Web env (copy to .env.local and fill in)

# NestJS backend base URL (global prefix /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Firebase web app config (Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# AI features are intentionally unavailable in this release (Coming Soon).
NEXT_PUBLIC_AI_API_URL=

# --- AI Tutor (RAG) integration ---------------------------------------------
# Client-visible on/off switch for the tutor UI ("true" to show the chat).
NEXT_PUBLIC_AI_ENABLED=false
# Server-side only (NOT NEXT_PUBLIC — never exposed to the browser). Used by the
# /api/ai/chat proxy that adapts the web to the AI RAG service (POST /v1/rag/chat).
AI_API_BASE_URL=
AI_INTERNAL_API_KEY=
# UUID identifying this LMS tenant to the multi-tenant AI service.
AI_TENANT_ID=

# Never add payment secret keys or HMAC values to NEXT_PUBLIC_* variables.
# Payment session creation must run in a trusted server or serverless function.

# Optional preselected category UUID for course creation.
NEXT_PUBLIC_DEFAULT_CATEGORY_ID=
