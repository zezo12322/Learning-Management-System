# OptimaTech LMS — Web env (copy to .env.local and fill in)

# NestJS backend base URL (global prefix /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Firebase web app config (Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- AI Tutor (RAG) integration ---------------------------------------------
# Client-visible on/off switch for the tutor + studio UI ("true" to show them).
# This is the ONLY AI variable the web needs: the tutor calls the NestJS backend
# (/ai/lectures/:lectureId/chat|status|retry), which owns the AI service URL and
# its internal API key. Nothing AI-related is configured here any more — set
# AI_SERVICE_URL and INTERNAL_API_KEY on the backend instead.
NEXT_PUBLIC_AI_ENABLED=false

# Never add payment secret keys or HMAC values to NEXT_PUBLIC_* variables.
# Payment session creation must run in a trusted server or serverless function.

# Optional preselected category UUID for course creation.
NEXT_PUBLIC_DEFAULT_CATEGORY_ID=
