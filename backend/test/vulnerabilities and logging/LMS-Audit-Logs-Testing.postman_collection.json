                  "    console.warn('⚠️ 0 logs found. Did you run folders 01-08 yet?');",
                  "    console.warn('   Also check: http://localhost:4000 → Firestore → system_audit_logs');",
                  "} else {",
                  "    console.log('Latest action:', json.logs[0].action);",
                  "}"
                ]
              }
            }
