    {
      "name": "00 – Auth Setup (Run First)",
      "description": "Login all test users and store tokens.\nNo data to fill in – credentials match setup-users.js.\nRun all three in order before anything else.",
      "item": [
        {
          "name": "01 Login superadmin (reads logs)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.idToken) {",
                  "    pm.collectionVariables.set('superAdminToken', json.idToken);",
                  "    console.log('✅ superAdminToken stored');",
                  "} else {",
                  "    console.error('❌ Login failed. Run setup-users.js first.', JSON.stringify(json));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"superadmin@test.com\", \"password\": \"password123\", \"returnSecureToken\": true}"
            },
            "url": {
              "raw": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebaseApiKey}}",
              "host": ["identitytoolkit.googleapis.com"],
              "path": ["v1", "accounts:signInWithPassword"],
              "query": [{ "key": "key", "value": "{{firebaseApiKey}}" }]
            },
            "description": "📌 NO DATA NEEDED – credentials pre-filled.\nStores token in {{superAdminToken}}. Required for folder 08 (reading logs)."
          }
        },
