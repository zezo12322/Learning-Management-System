            "header": [],
            "url": {
              "raw": "{{backendUrl}}/admin/logs?limit=50",
              "host": ["{{backendUrl}}"],
              "path": ["admin", "logs"],
              "query": [
                { "key": "limit",    "value": "50",  "description": "Max logs to return (default 50)" },
