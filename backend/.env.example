# ============================================================================
#  OptimaTech LMS — Backend (NestJS) environment
#  Copy to `.env` and fill in real values. NEVER commit the real .env.
# ============================================================================

# --- Server ---
PORT=3000
# Comma-separated allow-list of frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Public base URL of THIS backend (used to build absolute URLs, e.g. the Paymob
# webhook and the HLS key/manifest endpoints). Must be reachable by clients/Paymob.
API_PUBLIC_URL=http://localhost:3000
# Public base URL of the web app (used for post-payment redirection).
WEB_PUBLIC_URL=http://localhost:3000

# --- Firebase / Data Connect ---
# Path to the Firebase Admin service-account JSON (never commit the file itself).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Firebase Web API key (used by the Data Connect REST client).
FIREBASE_API_KEY=

# --- Redis (BullMQ queues + throttling) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Secure video streaming ---
# HMAC secret for HLS key tokens + watermark signatures. Required for secure video.
STREAM_KEY_SECRET=
# Validity window (minutes) for signed segment URLs / key tokens.
STREAM_URL_TTL_MINUTES=15

# ============================================================================
#  Payments — Paymob (Accept) Egypt
#  Server-only secrets. Do NOT expose SECRET_KEY / HMAC_SECRET to any client.
#  Rotate immediately if a value is ever leaked (e.g. pasted into chat/logs).
# ============================================================================
# Secret key (egy_sk_live_… in production, egy_sk_test_… for testing).
PAYMOB_SECRET_KEY=
# Public key (egy_pk_live_… / egy_pk_test_…). Safe to expose to the client.
PAYMOB_PUBLIC_KEY=
# HMAC secret used to verify the transaction-processed webhook. Server-only.
PAYMOB_HMAC_SECRET=
# Comma-separated Paymob payment-integration IDs (from the Paymob dashboard).
PAYMOB_INTEGRATION_IDS=
# Base URL for the Paymob API (default shown).
PAYMOB_BASE_URL=https://accept.paymob.com
