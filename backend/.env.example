# =============================================================================
# OptimaTech LMS — Backend Environment Configuration
# =============================================================================

# --- Core App & HTTP ---------------------------------------------------------
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Comma-separated production origins allowed by CORS. Any localhost origin is
# always allowed, so this is only needed for deployed frontends.
CORS_ORIGINS=
# Public base URL of THIS API, embedded in HLS key/sub-playlist URLs. In
# production this must be the real Railway hostname, not localhost.
API_PUBLIC_URL=http://localhost:3001

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Firebase & Data Connect -------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=../firebase-service-account.json
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_STORAGE_BUCKET=your_firebase_project_id_here.firebasestorage.app
FDC_LOCATION=europe-west8
FDC_SERVICE_ID=your_fdc_service_id_here
FDC_CONNECTOR_ID=default
FDC_TIMEOUT_MS=15000

# --- Secure Video Streaming (AES-128 HLS) ------------------------------------
STREAM_KEY_SECRET=your_stream_key_secret_here
STREAM_URL_TTL_MINUTES=360

# --- Paymob Integration (NextGen API) ----------------------------------------
PAYMOB_SECRET_KEY=your_paymob_secret_key_here
PAYMOB_PUBLIC_KEY=your_paymob_public_key_here
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret_here
PAYMOB_INTEGRATION_IDS=your_paymob_integration_ids_here

# --- AI Integration ----------------------------------------------------------
AI_SERVICE_URL=your_ai_service_url_here
INTERNAL_API_KEY=your_internal_api_key_here

# =============================================================================
# Health & Monitoring (KAN-147)
# =============================================================================

# --- Readiness probe (/api/v1/health/ready) ----------------------------------
# Per-dependency timeout for the readiness checks, ms. Keep well below whatever
# interval polls the endpoint. default: 3000
HEALTH_CHECK_TIMEOUT_MS=3000
# How long a readiness result is reused before re-checking, ms. Stops a load
# balancer, an uptime monitor and a deploy verification loop from each billing a
# separate Data Connect query. default: 10000
HEALTH_CACHE_MS=10000

# --- Graceful shutdown (zero-downtime deploys) -------------------------------
# How long readiness reports 503 before the server stops accepting connections,
# ms — gives the router time to take this instance out of rotation. default: 5000
SHUTDOWN_DRAIN_DELAY_MS=5000
# Hard ceiling on the whole shutdown, ms. Must stay below `drainingSeconds` in
# railway.json (30s) or the platform SIGKILLs mid-cleanup. default: 20000
SHUTDOWN_TIMEOUT_MS=20000

# --- Alerting ----------------------------------------------------------------
# Slack Incoming Webhook (also works with Discord's /slack endpoint and Teams
# workflow URLs). LEAVE EMPTY LOCALLY — alerting no-ops when unset, and the
# startup log says so. Set it only in the deployed environment.
ALERT_WEBHOOK_URL=
# Minimum gap between two alerts sharing the same key, ms. default: 300000 (5m)
ALERT_COOLDOWN_MS=300000
# Timeout for the webhook POST itself, ms. default: 5000
ALERT_TIMEOUT_MS=5000
# Label shown in every alert, e.g. "production". default: NODE_ENV
ALERT_ENV_LABEL=
# Rolling window for the error-rate alarm, ms. default: 300000 (5m)
ALERT_ERROR_RATE_WINDOW_MS=300000
# 5xx share that trips the alarm, 0-1. default: 0.1 (10%)
ALERT_ERROR_RATE_THRESHOLD=0.1
# Requests required in the window before the rate is judged. Without this, the
# first request of a quiet night failing reads as a 100% error rate. default: 20
ALERT_ERROR_RATE_MIN_SAMPLES=20

# =============================================================================
# E2E smoke tests only (npm run test:e2e:*) — not needed to run the API
# =============================================================================
SMOKE_INSTRUCTOR_EMAIL=instructor@example.com
SMOKE_INSTRUCTOR_PASSWORD=123456
SMOKE_STUDENT_EMAIL=student@example.com
SMOKE_STUDENT_PASSWORD=123456

# =============================================================================
App Check & Legal Compliance
# =============================================================================
# App Check mode: 'monitor' (default) validates tokens but doesn't block requests
# Change to 'enforce' after purchasing Apple ($99/yr) and Google ($25) developer accounts
APP_CHECK_MONITOR_MODE=true
# Token expiration time in minutes (default: 60)
APP_CHECK_TOKEN_EXPIRATION_MINUTES=60
